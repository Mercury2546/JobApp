# ========================================================
# AI Provider Configuration (Choose Option A, B, or C)
# ========================================================

# --- Option A: Official OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Option B: Custom / Groq Endpoint ---
# OPENAI_API_KEY=gsk_your_api_key_here
# OPENAI_MODEL=qwen/qwen3.8-27b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Option C: OpenRouter (Free & Paid Models - https://openrouter.ai) ---
# OPENAI_API_KEY=sk-or-v1-your_openrouter_api_key_here
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Option D: Local Ollama (No API Key Required) ---
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2
# OPENAI_BASE_URL=http://localhost:11434/v1

# ========================================================
# Database & Logging Settings
# ========================================================
DB_PATH=career_agent.db
LOG_LEVEL=INFO
