# ========================================================
# AI Provider Configuration (Choose Option A, B, or C)
# ========================================================

# --- Option A: Official OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Option B: Custom / Groq Endpoint ---
# OPENAI_API_KEY=gsk_your_api_key_here
# OPENAI_MODEL=qwen/qwen3.8-27b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Option C: OpenRouter (Free & Paid Models - https://openrouter.ai) ---
# OPENAI_API_KEY=sk-or-v1-your_openrouter_api_key_here
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Option D: Local Ollama (No API Key Required) ---
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2
# OPENAI_BASE_URL=http://localhost:11434/v1

# ========================================================
# Database & Logging Settings
# ========================================================
DB_PATH=career_agent.db
LOG_LEVEL=INFO

# ========================================================
# Notion Direct API Integration (1-Click Sync)
# ========================================================
# 1. Notion Internal Integration Secret (ntn_... หรือ secret_...)
# ได้จาก https://www.notion.com/my-integrations -> + New integration
NOTION_API_KEY=your_notion_integration_secret_here

# 2. Notion Database ID (รหัส 32 ตัวอักษร หรือ URL เต็มของตาราง Notion)
# เช่น https://www.notion.so/myworkspace/1234567890abcdef1234567890abcdef?v=...
NOTION_DATABASE_ID=your_notion_database_id_or_url_here

